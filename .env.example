# Sample settings for readonly-mail. Placeholders only: this file is committed.
# Copy it to ~/.config/readonly-mail/accounts.env (the script reads it from there), chmod 600, and replace the values.
# The real file is gitignored and must never be committed.
#
# One line per account: MAIL_ACCOUNT_<NAME>=<address>. <NAME> in lower case is the label you type on the command line
# (MAIL_ACCOUNT_PERSONAL is used as: node readonly-mail.mjs mail-recent personal).
MAIL_ACCOUNT_PERSONAL=personal@example.com
MAIL_ACCOUNT_WORK=work@example.com
MAIL_ACCOUNT_SCHOOL=school@example.com

# Optional. The OAuth client downloaded from Google Cloud. Default: ~/.config/readonly-mail/client.json
# MAIL_CLIENT_FILE=/path/to/client.json
# Optional. Where the script looks for the file that holds the lines above. Default: ~/.config/readonly-mail/accounts.env
# MAIL_ENV_FILE=/path/to/accounts.env
