# Placeholders only. Copy to ~/.config/calma/accounts.env, chmod 600, and fill in.
# MAIL_ACCOUNT_<NAME>=<address>; <NAME> in lower case is the label on the command line (here: personal, work, school).
MAIL_ACCOUNT_PERSONAL=personal@example.com
MAIL_ACCOUNT_WORK=work@example.com
MAIL_ACCOUNT_SCHOOL=school@example.com

# MAIL_CLIENT_FILE=/path/to/client.json   # default: ~/.config/calma/client.json
# MAIL_ENV_FILE=/path/to/accounts.env     # default: ~/.config/calma/accounts.env
